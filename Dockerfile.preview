# syntax=docker/dockerfile:1

ARG RUNTIME_BASE_IMAGE=local-minidrama:preview-runtime-base

FROM node:24-bookworm-slim AS builder

# Match the production builder OS and Node major for native dependencies.
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 make g++ git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY frontweb/package.json frontweb/package-lock.json* ./frontweb/
RUN npm config set registry https://registry.npmmirror.com
RUN cd frontweb && npm ci --include=dev --no-audit --no-fund
COPY frontweb ./frontweb
# The ONLY permitted difference between a preview and production page state:
# a " (preview)" suffix in the document title. The suffix must be baked into
# the client bundle as well — the SPA router rewrites document.title on every
# navigation, which would otherwise discard the badge injected below.
ARG PREVIEW_TITLE_BADGE=""
RUN cd frontweb \
    && if [ -n "$PREVIEW_TITLE_BADGE" ]; then export VITE_TITLE_BADGE=' (preview)'; fi \
    && npm run build
RUN if [ -n "$PREVIEW_TITLE_BADGE" ]; then sed -i 's|</title>| (preview)</title>|' frontweb/dist/index.html; fi

COPY backend-node/package.json backend-node/package-lock.json* ./backend-node/
COPY backend-node/.npmrc ./backend-node/.npmrc
RUN cd backend-node && npm ci --omit=dev --no-audit --no-fund
COPY backend-node ./backend-node

FROM ${RUNTIME_BASE_IMAGE} AS runtime

# Production may still use the previous Node major during the upgrade.
# Match the builder ABI before loading better-sqlite3 from the new build.
COPY --from=builder /usr/local/bin/node /usr/local/bin/node

WORKDIR /app/backend-node
COPY --from=builder /build/backend-node ./
COPY --from=builder /build/frontweb/dist /app/frontweb/dist

ARG APP_REVISION=unknown
ENV NODE_ENV=production
ENV PORT=5679
ENV APP_REVISION=${APP_REVISION}
LABEL org.opencontainers.image.revision=${APP_REVISION}

EXPOSE 5679
VOLUME ["/app/backend-node/data"]
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "src/server.js"]
