# Copy to an untracked server-only file such as /data/apps/LocalMiniDrama/.env.
# The variable shape mirrors the existing lens-rhyme OSS deployment, but uses
# a MINIDRAMA_ prefix so the two services cannot overwrite each other.
MINIDRAMA_STORAGE_TYPE=oss
MINIDRAMA_OSS_ENDPOINT=https://oss-cn-<region>.aliyuncs.com
MINIDRAMA_OSS_BUCKET=<bucket-name>
MINIDRAMA_OSS_ACCESS_KEY_ID=<access-key-id>
MINIDRAMA_OSS_ACCESS_KEY_SECRET=<access-key-secret>
MINIDRAMA_OSS_PREFIX=local-mini-drama
# A Lens-style bare domain is also accepted and is treated as HTTPS.
MINIDRAMA_OSS_CDN_DOMAIN=media.example.com
# Keep false through deploy + dry-run + sampled legacy validation. Enable only
# after the explicit historical migration is confirmed.
MINIDRAMA_OSS_AUTO_ARCHIVE_ENABLED=false
