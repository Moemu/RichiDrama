# Copy to /data/minidrama-config/.prod.env and set mode 600.
# This file replaces minidrama.oss.env. The old name remains supported.

MINIDRAMA_STORAGE_TYPE=oss
MINIDRAMA_OSS_ENDPOINT=https://oss-cn-<region>.aliyuncs.com
MINIDRAMA_OSS_BUCKET=<bucket-name>
MINIDRAMA_OSS_ACCESS_KEY_ID=<access-key-id>
MINIDRAMA_OSS_ACCESS_KEY_SECRET=<access-key-secret>
MINIDRAMA_OSS_PREFIX=local-mini-drama
MINIDRAMA_OSS_CDN_DOMAIN=media.example.com
MINIDRAMA_OSS_AUTO_ARCHIVE_ENABLED=false

# Payments stay disabled until production channel acceptance is complete.
CFG_PAYMENTS__ENABLED=false
CFG_PAYMENTS__PUBLIC_BASE_URL=https://drama.richbest.cn
CFG_PAYMENTS__ALIPAY__ENABLED=false
CFG_PAYMENTS__WECHAT__ENABLED=false
