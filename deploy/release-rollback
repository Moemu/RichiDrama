#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib.sh"
require_root
acquire_lock
STATE="$RELEASE_ROOT/rollback.env"
[[ -f "$STATE" ]] || fail 'No rollback state exists.'
PREVIOUS_CONTAINER="$(awk -F= '$1=="PREVIOUS_CONTAINER"{print $2}' "$STATE")"
PREVIOUS_IMAGE="$(awk -F= '$1=="PREVIOUS_IMAGE"{print $2}' "$STATE")"
[[ "$PREVIOUS_CONTAINER" =~ ^minidrama-rollback-[0-9]+$ ]] || fail 'Rollback container name is invalid.'
docker inspect "$PREVIOUS_CONTAINER" >/dev/null 2>&1 || fail "Rollback container is missing: $PREVIOUS_CONTAINER"

docker stop --time 20 "$PROD_CONTAINER" >/dev/null 2>&1 || true
docker rm "$PROD_CONTAINER" >/dev/null 2>&1 || true
docker rename "$PREVIOUS_CONTAINER" "$PROD_CONTAINER"
docker start "$PROD_CONTAINER" >/dev/null
docker exec "$HTTP_NGINX_CONTAINER" nginx -s reload >/dev/null 2>&1 || true

for _ in {1..45}; do
  if docker exec "$PROD_CONTAINER" node -e 'require("http").get("http://127.0.0.1:5679/health",r=>process.exit(r.statusCode===200?0:1)).on("error",()=>process.exit(1))' >/dev/null 2>&1; then
    log "Rolled back production to $PREVIOUS_IMAGE"
    rm -f "$STATE"
    exit 0
  fi
  sleep 2
done
docker logs --tail 100 "$PROD_CONTAINER" >&2 || true
fail 'Rollback container did not become healthy.'
