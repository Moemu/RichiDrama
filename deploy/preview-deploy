#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=deploy/lib.sh
source "$SCRIPT_DIR/lib.sh"

require_root
validate_pr "${1:-}"
validate_sha "${2:-}"
PR_NUMBER="$1"
SHA="$2"
acquire_lock

if ! command -v certbot >/dev/null 2>&1; then
  if command -v apt-get >/dev/null 2>&1; then
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends certbot
  elif command -v dnf >/dev/null 2>&1; then
    dnf install -y certbot
  elif command -v yum >/dev/null 2>&1; then
    yum install -y certbot
  else
    fail 'certbot is required and no supported package manager is available.'
  fi
fi
command -v certbot >/dev/null 2>&1 || fail 'certbot installation failed.'
command -v openssl >/dev/null 2>&1 || fail 'openssl is required.'
: "${MINIDRAMA_ACME_EMAIL:?Set MINIDRAMA_ACME_EMAIL for certificate issuance.}"

mkdir -p "$PREVIEW_ROOT" "$RELEASE_ROOT" "$INCOMING_ROOT"
ACTIVE_COUNT="$(find "$PREVIEW_ROOT" -mindepth 1 -maxdepth 1 -type d -name 'pr-*' ! -name "pr-$PR_NUMBER" | wc -l | tr -d ' ')"
(( ACTIVE_COUNT < 2 )) || fail 'Two preview environments already exist.'

SOURCE_DIR="$(prepare_source "$SHA")"
IMAGE="$(build_image "$SHA" "$SOURCE_DIR")"

# Remove only the previous environment for this PR.
if [[ -d "$PREVIEW_ROOT/pr-$PR_NUMBER" ]]; then
  remove_preview_resources "$PR_NUMBER" 1
fi

TOKEN="$(openssl rand -hex 8)"
PASSWORD="$(openssl rand -hex 16)"
HOST="pr-${PR_NUMBER}-${TOKEN}.preview.drama.richbest.cn"
PREFIX="minidrama-pr-${PR_NUMBER}-${TOKEN}"
APP_CONTAINER="${PREFIX}-app"
GATEWAY_CONTAINER="${PREFIX}-gateway"
NETWORK="${PREFIX}-internal"
PR_DIR="$PREVIEW_ROOT/pr-$PR_NUMBER"
DATA_DIR="$PR_DIR/data"
mkdir -p "$DATA_DIR" "$PR_DIR/gateway"

cat > "$PR_DIR/metadata.env" <<EOF
PR_NUMBER=$PR_NUMBER
REVISION=$SHA
HOST=$HOST
URL=https://$HOST/
USERNAME=preview
PASSWORD=$PASSWORD
APP_CONTAINER=$APP_CONTAINER
GATEWAY_CONTAINER=$GATEWAY_CONTAINER
NETWORK=$NETWORK
CREATED_AT=$(date +%s)
EOF
chmod 600 "$PR_DIR/metadata.env"

PREVIEW_SUCCESS=0
cleanup_failed_preview() {
  local exit_code=$?
  trap - EXIT
  if [[ "$PREVIEW_SUCCESS" != 1 ]]; then
    log "Cleaning failed preview for PR $PR_NUMBER."
    set +e
    remove_preview_resources "$PR_NUMBER" 1
  fi
  exit "$exit_code"
}
trap cleanup_failed_preview EXIT

create_online_snapshot "$DATA_DIR/drama_generator.db"
verify_migrations "$IMAGE" "$DATA_DIR"
run_preflight_app "$IMAGE" "$SHA" "$DATA_DIR"

sed "s/__PREVIEW_HOST__/$HOST/g" "$SOURCE_DIR/deploy/preview-gateway.conf.template" > "$PR_DIR/gateway/default.conf"
printf 'preview:%s\n' "$(openssl passwd -apr1 "$PASSWORD")" > "$PR_DIR/gateway/htpasswd"
chmod 600 "$PR_DIR/gateway/htpasswd"

docker network create --internal "$NETWORK" >/dev/null
ENV_FILE="$(resolve_env_file)"
ENV_ARGS=()
[[ -n "$ENV_FILE" ]] && ENV_ARGS+=(--env-file "$ENV_FILE")

docker run -d --name "$APP_CONTAINER" --network "$NETWORK" --network-alias preview-app \
  --label "com.richidrama.preview-pr=$PR_NUMBER" --label "com.richidrama.revision=$SHA" \
  --security-opt no-new-privileges --cap-drop ALL --pids-limit 256 \
  --memory 2g --cpus 1 --read-only --tmpfs /tmp:rw,noexec,nosuid,size=128m \
  "${ENV_ARGS[@]}" -e NODE_ENV=production -e PORT=5679 -e "APP_REVISION=$SHA" \
  -v "$DATA_DIR:/app/backend-node/data" "$IMAGE" >/dev/null

wait_container_ready "$APP_CONTAINER" "$SHA" 90 || fail 'Preview application did not become ready.'

docker run -d --name "$GATEWAY_CONTAINER" --network "$NETWORK" \
  --label "com.richidrama.preview-pr=$PR_NUMBER" \
  --security-opt no-new-privileges --cap-drop ALL --pids-limit 64 \
  --memory 128m --cpus 0.25 --read-only \
  --tmpfs /tmp:rw,noexec,nosuid,size=16m --tmpfs /var/cache/nginx:rw,noexec,nosuid,size=16m \
  --tmpfs /var/run:rw,noexec,nosuid,size=4m \
  -v "$PR_DIR/gateway/default.conf:/etc/nginx/conf.d/default.conf:ro" \
  -v "$PR_DIR/gateway/htpasswd:/etc/nginx/htpasswd:ro" \
  nginxinc/nginx-unprivileged:1.27-alpine >/dev/null
PROXY_NETWORK="$(resolve_proxy_network)"
docker network connect --alias "$GATEWAY_CONTAINER" "$PROXY_NETWORK" "$GATEWAY_CONTAINER"
GATEWAY_PROXY_IP="$(docker inspect --format "{{(index .NetworkSettings.Networks \"$PROXY_NETWORK\").IPAddress}}" "$GATEWAY_CONTAINER")"
[[ "$GATEWAY_PROXY_IP" =~ ^[0-9]+(\.[0-9]+){3}$ ]] || fail 'Cannot resolve the preview gateway IP.'

# Install the permanent HTTP-01 entry before requesting the exact certificate.
docker exec "$NGINX_CONTAINER" mkdir -p /var/www/minidrama-acme/.well-known/acme-challenge /etc/nginx/preview-certs
docker cp "$SOURCE_DIR/deploy/nginx-preview-http.conf" "$NGINX_CONTAINER:/etc/nginx/conf.d/minidrama-preview-http.conf"
docker exec "$NGINX_CONTAINER" nginx -t
docker exec "$NGINX_CONTAINER" nginx -s reload

CERT_ISSUED=0
for attempt in 1 2; do
  if MINIDRAMA_NGINX_CONTAINER="$NGINX_CONTAINER" certbot certonly --manual --non-interactive --agree-tos \
    --email "$MINIDRAMA_ACME_EMAIL" --preferred-challenges http \
    --manual-auth-hook "bash $SOURCE_DIR/deploy/acme-auth-hook.sh" \
    --manual-cleanup-hook "bash $SOURCE_DIR/deploy/acme-cleanup-hook.sh" \
    --cert-name "$HOST" -d "$HOST" >"$PR_DIR/certbot.log" 2>&1; then
    CERT_ISSUED=1
    break
  fi
  [[ "$attempt" == 2 ]] || sleep 5
done
if [[ "$CERT_ISSUED" != 1 ]]; then
  grep -Ei 'detail:|error:|unauthorized|ratelimited|too many|timeout|connection refused|invalid response' \
    "$PR_DIR/certbot.log" | tail -n 8 | \
    sed -E "s/$HOST/[preview-host]/g; s/[0-9]{1,3}(\.[0-9]{1,3}){3}/[ip]/g" >&2 || true
  fail 'Preview certificate issuance failed. Read the private server log for full details.'
fi

docker exec "$NGINX_CONTAINER" mkdir -p "/etc/nginx/preview-certs/$HOST"
docker cp -L "/etc/letsencrypt/live/$HOST/fullchain.pem" "$NGINX_CONTAINER:/etc/nginx/preview-certs/$HOST/fullchain.pem"
docker cp -L "/etc/letsencrypt/live/$HOST/privkey.pem" "$NGINX_CONTAINER:/etc/nginx/preview-certs/$HOST/privkey.pem"

cat > "$PR_DIR/outer-nginx.conf" <<EOF
server {
    listen 80;
    server_name $HOST;
    location ^~ /.well-known/acme-challenge/ { root /var/www/minidrama-acme; }
    location / { return 301 https://\$host\$request_uri; }
}
server {
    listen 443 ssl;
    server_name $HOST;
    ssl_certificate /etc/nginx/preview-certs/$HOST/fullchain.pem;
    ssl_certificate_key /etc/nginx/preview-certs/$HOST/privkey.pem;
    location / {
        proxy_pass http://$GATEWAY_PROXY_IP:8080;
        proxy_http_version 1.1;
        proxy_set_header Host \$http_host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
EOF
docker cp "$PR_DIR/outer-nginx.conf" "$NGINX_CONTAINER:/etc/nginx/conf.d/preview-pr-$PR_NUMBER.conf"
docker exec "$NGINX_CONTAINER" nginx -t
docker exec "$NGINX_CONTAINER" nginx -s reload

curl -fsS --max-time 15 --resolve "$HOST:443:127.0.0.1" -u "preview:$PASSWORD" "https://$HOST/ready" | \
  grep -q "\"revision\":\"$SHA\"" || fail 'External preview readiness check failed.'

bash "$SOURCE_DIR/deploy/install-operations" preview
PREVIEW_SUCCESS=1
trap - EXIT
log "Preview for PR $PR_NUMBER is ready. Use preview-show to read its private access details."
