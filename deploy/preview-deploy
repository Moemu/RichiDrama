#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=deploy/lib.sh
source "$SCRIPT_DIR/lib.sh"

require_root
validate_pr "${1:-}"
validate_sha "${2:-}"
PR_NUMBER="$1"
SHA="$2"
acquire_lock
validate_production_ingress

SOURCE_DIR="$(prepare_source "$SHA")"
IMAGE="$(build_preview_image "$SHA" "$SOURCE_DIR")"

# Install the server-side operation commands early so preview-remove,
# preview-show and preview-cleanup exist even if a later step fails.
bash "$SOURCE_DIR/deploy/install-operations" preview

# Remove only the previous environment for this PR.
if [[ -d "$PREVIEW_ROOT/pr-$PR_NUMBER" ]]; then
  remove_preview_resources "$PR_NUMBER"
fi

HOST="pr-${PR_NUMBER}.preview.drama.richbest.cn"
APP_CONTAINER="minidrama-pr-${PR_NUMBER}"
PR_DIR="$PREVIEW_ROOT/pr-$PR_NUMBER"
DATA_DIR="$PR_DIR/data"
AUTH_DIR="$PREVIEW_ROOT/auth"
mkdir -p "$DATA_DIR" "$AUTH_DIR"

PASSWORD="$(cat "$AUTH_DIR/password" 2>/dev/null || true)"
if [[ ! "$PASSWORD" =~ ^[0-9a-f]{32}$ ]]; then
  PASSWORD="$(openssl rand -hex 16)"
  printf '%s\n' "$PASSWORD" > "$AUTH_DIR/password"
  chmod 600 "$AUTH_DIR/password"
fi
printf 'preview:%s\n' "$(openssl passwd -apr1 "$PASSWORD")" > "$AUTH_DIR/htpasswd"
chown 101:101 "$AUTH_DIR/htpasswd"
chmod 600 "$AUTH_DIR/htpasswd"

cat > "$PR_DIR/metadata.env" <<EOF
PR_NUMBER=$PR_NUMBER
REVISION=$SHA
HOST=$HOST
URL=http://$HOST/
USERNAME=preview
PASSWORD=$PASSWORD
APP_CONTAINER=$APP_CONTAINER
CREATED_AT=$(date +%s)
EOF
chmod 600 "$PR_DIR/metadata.env"

PREVIEW_SUCCESS=0
cleanup_failed_preview() {
  local exit_code=$?
  trap - EXIT
  if [[ "$PREVIEW_SUCCESS" != 1 ]]; then
    log "Cleaning failed preview for PR $PR_NUMBER."
    set +e
    remove_preview_resources "$PR_NUMBER"
  fi
  exit "$exit_code"
}
trap cleanup_failed_preview EXIT

# Migration safety: run every migration twice against a copy of the current
# production database before the preview application starts on that copy.
create_online_snapshot "$DATA_DIR/drama_generator.db"
verify_migrations "$IMAGE" "$DATA_DIR"

ensure_preview_network
attach_ingress_to_preview_network
install_preview_http_ingress "$SOURCE_DIR/deploy/nginx-preview-http.conf"

ENV_FILE="$(resolve_env_file)"
ENV_ARGS=()
[[ -n "$ENV_FILE" ]] && ENV_ARGS+=(--env-file "$ENV_FILE")

docker run -d --name "$APP_CONTAINER" \
  --network "$PREVIEW_NETWORK" --network-alias "pr-$PR_NUMBER" \
  --label "com.richidrama.preview-pr=$PR_NUMBER" --label "com.richidrama.revision=$SHA" \
  --security-opt no-new-privileges --cap-drop ALL --pids-limit 256 \
  --memory 2g --cpus 1 --read-only --tmpfs /tmp:rw,noexec,nosuid,size=128m \
  "${ENV_ARGS[@]}" -e NODE_ENV=production -e PORT=5679 -e "APP_REVISION=$SHA" \
  -v "$DATA_DIR:/app/backend-node/data" "$IMAGE" >/dev/null || \
  fail 'Cannot create the preview application container.'

wait_container_ready "$APP_CONTAINER" "$SHA" 90 || fail 'Preview application did not become ready.'

APP_NETWORKS="$(docker inspect --format '{{range $name, $_ := .NetworkSettings.Networks}}{{println $name}}{{end}}' "$APP_CONTAINER")"
[[ "$(sed '/^$/d' <<<"$APP_NETWORKS")" == "$PREVIEW_NETWORK" ]] || \
  fail 'Preview app joined an unexpected Docker network.'
if docker exec "$APP_CONTAINER" node -e 'const request=require("http").get({host:"1.1.1.1",port:80,timeout:2000},()=>process.exit(0));request.on("timeout",()=>{request.destroy();process.exit(1)});request.on("error",()=>process.exit(1))'; then
  fail 'Preview app can access the public network.'
fi

# The ingress must reach the isolated application through Docker DNS.
docker exec "$HTTP_NGINX_CONTAINER" wget -qO- \
  "http://pr-${PR_NUMBER}:5679/ready" | grep -q "\"revision\":\"$SHA\"" || \
  fail 'HTTP ingress cannot reach the isolated preview application.'

[[ "$(curl -sS --max-time 15 --resolve "$HOST:80:127.0.0.1" -o /dev/null -w '%{http_code}' "http://$HOST/ready")" == 401 ]] || \
  fail 'Preview Basic Auth accepted a request without credentials.'
[[ "$(curl -sS --max-time 15 --resolve "$HOST:80:127.0.0.1" -u 'preview:incorrect' -o /dev/null -w '%{http_code}' "http://$HOST/ready")" == 401 ]] || \
  fail 'Preview Basic Auth accepted incorrect credentials.'
curl -fsS --max-time 15 --resolve "$HOST:80:127.0.0.1" -u "preview:$PASSWORD" "http://$HOST/ready" | \
  grep -q "\"revision\":\"$SHA\"" || fail 'External preview readiness check failed.'

PROD_DOMAIN="${MINIDRAMA_PROD_DOMAIN:-drama.richbest.cn}"
curl -fsS --max-time 10 -H "Host: $PROD_DOMAIN" http://127.0.0.1/ready >/dev/null || \
  fail 'The existing production route failed after the ingress reload.'
unset PASSWORD

PREVIEW_SUCCESS=1
trap - EXIT
log "Preview for PR $PR_NUMBER is ready at http://$HOST/. Use preview-show to read its access details."
