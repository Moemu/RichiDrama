#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=deploy/lib.sh
source "$SCRIPT_DIR/lib.sh"

require_root
validate_pr "${1:-}"
validate_sha "${2:-}"
PR_NUMBER="$1"
SHA="$2"
acquire_lock
validate_production_ingress

if ! command -v certbot >/dev/null 2>&1; then
  if command -v apt-get >/dev/null 2>&1; then
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends certbot
  elif command -v dnf >/dev/null 2>&1; then
    dnf install -y certbot
  elif command -v yum >/dev/null 2>&1; then
    yum install -y certbot
  else
    fail 'certbot is required and no supported package manager is available.'
  fi
fi
command -v certbot >/dev/null 2>&1 || fail 'certbot installation failed.'
command -v openssl >/dev/null 2>&1 || fail 'openssl is required.'
: "${MINIDRAMA_ACME_EMAIL:?Set MINIDRAMA_ACME_EMAIL for certificate issuance.}"

mkdir -p "$PREVIEW_ROOT" "$RELEASE_ROOT" "$INCOMING_ROOT"
ACTIVE_COUNT="$(find "$PREVIEW_ROOT" -mindepth 1 -maxdepth 1 -type d -name 'pr-*' ! -name "pr-$PR_NUMBER" | wc -l | tr -d ' ')"
(( ACTIVE_COUNT < 2 )) || fail 'Two preview environments already exist.'

SOURCE_DIR="$(prepare_source "$SHA")"
IMAGE="$(build_preview_image "$SHA" "$SOURCE_DIR")"

# Remove only the previous environment for this PR.
if [[ -d "$PREVIEW_ROOT/pr-$PR_NUMBER" ]]; then
  remove_preview_resources "$PR_NUMBER" 1
fi

TOKEN="$(openssl rand -hex 8)"
PASSWORD="$(openssl rand -hex 16)"
HOST="pr-${PR_NUMBER}-${TOKEN}.preview.drama.richbest.cn"
PREFIX="minidrama-pr-${PR_NUMBER}-${TOKEN}"
APP_CONTAINER="${PREFIX}-app"
GATEWAY_CONTAINER="${PREFIX}-gateway"
ANCHOR_CONTAINER="${PREFIX}-network"
NETWORK="${PREFIX}-internal"
PR_DIR="$PREVIEW_ROOT/pr-$PR_NUMBER"
DATA_DIR="$PR_DIR/data"
mkdir -p "$DATA_DIR" "$PR_DIR/gateway"

cat > "$PR_DIR/metadata.env" <<EOF
PR_NUMBER=$PR_NUMBER
REVISION=$SHA
HOST=$HOST
URL=https://$HOST/
USERNAME=preview
PASSWORD=$PASSWORD
APP_CONTAINER=$APP_CONTAINER
GATEWAY_CONTAINER=$GATEWAY_CONTAINER
ANCHOR_CONTAINER=$ANCHOR_CONTAINER
NETWORK=$NETWORK
CREATED_AT=$(date +%s)
EOF
chmod 600 "$PR_DIR/metadata.env"

PREVIEW_SUCCESS=0
cleanup_failed_preview() {
  local exit_code=$?
  trap - EXIT
  if [[ "$PREVIEW_SUCCESS" != 1 ]]; then
    log "Cleaning failed preview for PR $PR_NUMBER."
    set +e
    remove_preview_resources "$PR_NUMBER" 1
  fi
  exit "$exit_code"
}
trap cleanup_failed_preview EXIT

create_online_snapshot "$DATA_DIR/drama_generator.db"
verify_migrations "$IMAGE" "$DATA_DIR"
run_preflight_app "$IMAGE" "$SHA" "$DATA_DIR"

printf 'preview:%s\n' "$(openssl passwd -apr1 "$PASSWORD")" > "$PR_DIR/gateway/htpasswd"
chown 101:101 "$PR_DIR/gateway/htpasswd"
chmod 600 "$PR_DIR/gateway/htpasswd"

docker network create "$NETWORK" >/dev/null || fail 'Cannot create the preview Docker network.'
require_container_network "$TLS_NGINX_CONTAINER" "$TLS_PROXY_NETWORK"
ENV_FILE="$(resolve_env_file)"
ENV_ARGS=()
[[ -n "$ENV_FILE" ]] && ENV_ARGS+=(--env-file "$ENV_FILE")

docker run -d --name "$ANCHOR_CONTAINER" --network "$NETWORK" --network-alias preview-app \
  --label "com.richidrama.preview-pr=$PR_NUMBER" \
  --security-opt no-new-privileges --cap-drop ALL --pids-limit 16 --memory 32m --cpus 0.1 \
  --read-only --tmpfs /tmp:rw,noexec,nosuid,size=4m \
  --entrypoint sh nginxinc/nginx-unprivileged:1.27-alpine -c 'exec sleep 2147483647' >/dev/null || \
  fail 'Cannot create the preview network namespace.'

docker run --rm --network "container:$ANCHOR_CONTAINER" \
  --user 0 --cap-drop ALL --cap-add NET_ADMIN --entrypoint sh \
  nginxinc/nginx-unprivileged:1.27-alpine -eu -c 'busybox ip route del default' || \
  fail 'Cannot remove the preview default route.'
docker exec "$ANCHOR_CONTAINER" sh -eu -c \
  'test -z "$(busybox ip route show default)"' || \
  fail 'The preview network namespace still has a default route.'

docker create --name "$APP_CONTAINER" --network "container:$ANCHOR_CONTAINER" \
  --label "com.richidrama.preview-pr=$PR_NUMBER" --label "com.richidrama.revision=$SHA" \
  --security-opt no-new-privileges --cap-drop ALL --pids-limit 256 \
  --memory 2g --cpus 1 --read-only --tmpfs /tmp:rw,noexec,nosuid,size=128m \
  "${ENV_ARGS[@]}" -e NODE_ENV=production -e PORT=5679 -e "APP_REVISION=$SHA" \
  -v "$DATA_DIR:/app/backend-node/data" "$IMAGE" >/dev/null || \
  fail 'Cannot create the preview application container.'
docker start "$APP_CONTAINER" >/dev/null || fail 'Cannot start the preview application container.'

wait_container_ready "$APP_CONTAINER" "$SHA" 90 || fail 'Preview application did not become ready.'

APP_NETWORK_MODE="$(docker inspect --format '{{.HostConfig.NetworkMode}}' "$APP_CONTAINER")"
[[ "$APP_NETWORK_MODE" == "container:$ANCHOR_CONTAINER" ]] || fail 'Preview app does not use the isolated network namespace.'
ANCHOR_NETWORKS="$(docker inspect --format '{{range $name, $_ := .NetworkSettings.Networks}}{{println $name}}{{end}}' "$ANCHOR_CONTAINER")"
[[ "$(sed '/^$/d' <<<"$ANCHOR_NETWORKS")" == "$NETWORK" ]] || fail 'Preview network anchor joined an unexpected Docker network.'
docker exec "$APP_CONTAINER" sh -eu -c '! busybox ip route show default | grep -q .' || \
  fail 'Preview app network namespace has a default route.'
docker exec "$APP_CONTAINER" node -e 'require("dns").lookup("minidrama-app",error=>process.exit(error?0:1))' || \
  fail 'Preview app can resolve the production application network.'
if docker exec "$APP_CONTAINER" node -e 'const request=require("http").get({host:"1.1.1.1",port:80,timeout:2000},()=>process.exit(0));request.on("timeout",()=>{request.destroy();process.exit(1)});request.on("error",()=>process.exit(1))'; then
  fail 'Preview app can access the public network.'
fi

sed "s/__PREVIEW_HOST__/$HOST/g" "$SOURCE_DIR/deploy/preview-gateway.conf.template" > "$PR_DIR/gateway/default.conf"
docker create --name "$GATEWAY_CONTAINER" \
  --network "name=$TLS_PROXY_NETWORK,alias=$GATEWAY_CONTAINER,gw-priority=1" \
  --label "com.richidrama.preview-pr=$PR_NUMBER" \
  --security-opt no-new-privileges --cap-drop ALL --pids-limit 64 \
  --memory 128m --cpus 0.25 --read-only \
  --tmpfs /tmp:rw,noexec,nosuid,size=16m --tmpfs /var/cache/nginx:rw,noexec,nosuid,size=16m \
  --tmpfs /var/run:rw,noexec,nosuid,size=4m \
  -v "$PR_DIR/gateway/default.conf:/etc/nginx/conf.d/default.conf:ro" \
  -v "$PR_DIR/gateway/htpasswd:/etc/nginx/htpasswd:ro" \
  nginxinc/nginx-unprivileged:1.27-alpine >/dev/null
docker network connect --gw-priority -1 "$NETWORK" "$GATEWAY_CONTAINER"
docker start "$GATEWAY_CONTAINER" >/dev/null
if ! docker ps --format '{{.Names}}' | grep -Fqx "$GATEWAY_CONTAINER"; then
  docker logs --tail 50 "$GATEWAY_CONTAINER" >&2 || true
  fail 'Preview gateway stopped during startup.'
fi

AUTH_HEADER="$(printf 'preview:%s' "$PASSWORD" | openssl base64 -A)"
docker exec "$GATEWAY_CONTAINER" wget -qO- \
  --header="Host: $HOST" --header="Authorization: Basic $AUTH_HEADER" \
  'http://127.0.0.1:8080/ready' | grep -q "\"revision\":\"$SHA\"" || \
  fail 'Preview gateway cannot reach the isolated application.'
GATEWAY_READY="$(docker exec "$TLS_NGINX_CONTAINER" wget -qO- \
  --header="Host: $HOST" --header="Authorization: Basic $AUTH_HEADER" \
  "http://$GATEWAY_CONTAINER:8080/ready")" || fail 'TLS ingress cannot reach the preview gateway through Docker DNS.'
grep -q "\"revision\":\"$SHA\"" <<<"$GATEWAY_READY" || fail 'Preview gateway returned the wrong revision.'
unset AUTH_HEADER GATEWAY_READY

# Install the permanent HTTP-01 entry before requesting the exact certificate.
require_running_container "$HTTP_NGINX_CONTAINER"
docker exec "$HTTP_NGINX_CONTAINER" mkdir -p /var/www/minidrama-acme/.well-known/acme-challenge
docker cp "$SOURCE_DIR/deploy/nginx-preview-http.conf" "$HTTP_NGINX_CONTAINER:/etc/nginx/conf.d/minidrama-preview-http.conf"
docker exec "$HTTP_NGINX_CONTAINER" nginx -t
docker exec "$HTTP_NGINX_CONTAINER" nginx -s reload

CERT_ISSUED=0
for attempt in 1 2; do
  if MINIDRAMA_HTTP_NGINX_CONTAINER="$HTTP_NGINX_CONTAINER" certbot certonly --manual --non-interactive --agree-tos \
    --email "$MINIDRAMA_ACME_EMAIL" --preferred-challenges http \
    --manual-auth-hook "bash $SOURCE_DIR/deploy/acme-auth-hook.sh" \
    --manual-cleanup-hook "bash $SOURCE_DIR/deploy/acme-cleanup-hook.sh" \
    --cert-name "$HOST" -d "$HOST" >"$PR_DIR/certbot.log" 2>&1; then
    CERT_ISSUED=1
    break
  fi
  [[ "$attempt" == 2 ]] || sleep 5
done
if [[ "$CERT_ISSUED" != 1 ]]; then
  grep -Ei 'detail:|error:|unauthorized|ratelimited|too many|timeout|connection refused|invalid response' \
    "$PR_DIR/certbot.log" | tail -n 8 | \
    sed -E "s/$HOST/[preview-host]/g; s/[0-9]{1,3}(\.[0-9]{1,3}){3}/[ip]/g" >&2 || true
  fail 'Preview certificate issuance failed. Read the private server log for full details.'
fi

[[ -r "/etc/letsencrypt/live/$HOST/fullchain.pem" && -r "/etc/letsencrypt/live/$HOST/privkey.pem" ]] || \
  fail 'Issued certificate files are not readable on the host.'
docker exec "$TLS_NGINX_CONTAINER" test -r "/etc/letsencrypt/live/$HOST/fullchain.pem"
docker exec "$TLS_NGINX_CONTAINER" test -r "/etc/letsencrypt/live/$HOST/privkey.pem"

sed "s/__PREVIEW_HOST__/$HOST/g" "$SOURCE_DIR/deploy/nginx-preview-redirect.conf.template" > "$PR_DIR/http-nginx.conf"
sed -e "s/__PREVIEW_HOST__/$HOST/g" -e "s/__GATEWAY_HOST__/$GATEWAY_CONTAINER/g" \
  "$SOURCE_DIR/deploy/nginx-preview-tls.conf.template" > "$PR_DIR/tls-nginx.conf"

docker cp "$PR_DIR/http-nginx.conf" "$HTTP_NGINX_CONTAINER:/etc/nginx/conf.d/preview-pr-$PR_NUMBER.conf"
docker exec "$HTTP_NGINX_CONTAINER" nginx -t
docker exec "$HTTP_NGINX_CONTAINER" nginx -s reload

docker cp "$SOURCE_DIR/deploy/nginx-tls-default-reject.conf" \
  "$TLS_NGINX_CONTAINER:/etc/nginx/conf.d/00-minidrama-default-reject.conf"
docker cp "$PR_DIR/tls-nginx.conf" "$TLS_NGINX_CONTAINER:/etc/nginx/conf.d/preview-pr-$PR_NUMBER.conf"
docker exec "$TLS_NGINX_CONTAINER" nginx -t
docker exec "$TLS_NGINX_CONTAINER" nginx -s reload

curl -fsS --max-time 15 "https://api.richbest.cn/health" >/dev/null || \
  fail 'The existing TLS API route failed after reload.'
REJECT_HOST="rejected-${TOKEN}.preview.drama.richbest.cn"
if curl -ksS --max-time 10 --resolve "$REJECT_HOST:443:127.0.0.1" "https://$REJECT_HOST/" >/dev/null 2>&1; then
  fail 'Unknown TLS hosts are not rejected.'
fi

[[ "$(curl -sS --max-time 15 --resolve "$HOST:443:127.0.0.1" -o /dev/null -w '%{http_code}' "https://$HOST/ready")" == 401 ]] || \
  fail 'Preview Basic Auth accepted a request without credentials.'
[[ "$(curl -sS --max-time 15 --resolve "$HOST:443:127.0.0.1" -u 'preview:incorrect' -o /dev/null -w '%{http_code}' "https://$HOST/ready")" == 401 ]] || \
  fail 'Preview Basic Auth accepted incorrect credentials.'
curl -fsS --max-time 15 --resolve "$HOST:443:127.0.0.1" -u "preview:$PASSWORD" "https://$HOST/ready" | \
  grep -q "\"revision\":\"$SHA\"" || fail 'External preview readiness check failed.'

bash "$SOURCE_DIR/deploy/install-operations" preview
PREVIEW_SUCCESS=1
trap - EXIT
log "Preview for PR $PR_NUMBER is ready. Use preview-show to read its private access details."
