#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib.sh"
require_root
NOW="$(date +%s)"
TTL="${MINIDRAMA_PREVIEW_TTL_SECONDS:-259200}"
for metadata in "$PREVIEW_ROOT"/pr-*/metadata.env; do
  [[ -f "$metadata" ]] || continue
  pr="$(awk -F= '$1=="PR_NUMBER"{print $2}' "$metadata")"
  created="$(awk -F= '$1=="CREATED_AT"{print $2}' "$metadata")"
  if [[ "$pr" =~ ^[1-9][0-9]*$ && "$created" =~ ^[0-9]+$ ]] && (( NOW - created > TTL )); then
    bash "$SCRIPT_DIR/preview-remove" "$pr"
  fi
done
