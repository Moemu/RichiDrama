server {
    listen 443 ssl;
    server_name __PREVIEW_HOST__;

    ssl_certificate /etc/letsencrypt/live/__PREVIEW_HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__PREVIEW_HOST__/privkey.pem;

    location / {
        proxy_pass http://__GATEWAY_IP__:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
