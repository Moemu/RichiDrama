#!/usr/bin/env bash
# Manual, server-side PR preview rebuild.
#
# Why this exists: the `PR Preview` workflow runs the whole deploy inside one
# SSH command bounded by `command_timeout` (40m by default). When the upstream
# apt/npm mirrors are slow — they degrade in particular time windows — the
# image build on the production host can still be running when that bound is
# reached, and the deploy is killed mid-build with `Process completed with exit
# code 1`. This script runs the same deployment directly on the host, so the
# build is no longer bounded by the runner's SSH session. With --detach it
# survives the operator's own SSH session too.
#
# This is a privileged operator action: the CI workflow additionally checks
# `author_association` and that the PR head lives in this repository. The
# server-side path keeps the equivalent guard by requiring the commit to be the
# head of a branch in `origin` — fork-only commits are refused.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=deploy/lib.sh
source "$SCRIPT_DIR/lib.sh"

usage() {
  cat <<'EOF' >&2
Usage: preview-rebuild <pr-number> [--sha <40-hex-commit>] [--detach]

  <pr-number>   Open internal pull request whose head should be deployed.
  --sha         Require the PR head to be exactly this commit (optional).
  --detach      Run the deploy in the background and return immediately,
                surviving this SSH session. Follow it with `tail -f`.

Preview-identical deploy: same script (`preview-deploy`), same deploy lock,
same migration double-run against a production snapshot.
EOF
}

require_root

PR_NUMBER=''
EXPECTED_SHA=''
DETACH=0
POSITIONAL=()

while (( $# )); do
  case "$1" in
    --detach) DETACH=1; shift ;;
    --sha)
      [[ $# -ge 2 ]] || { usage; exit 2; }
      EXPECTED_SHA="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    -*) fail "Unknown option: $1" ;;
    *) POSITIONAL+=("$1"); shift ;;
  esac
done

[[ ${#POSITIONAL[@]} -eq 1 ]] || { usage; exit 2; }
PR_NUMBER="${POSITIONAL[0]}"
validate_pr "$PR_NUMBER"
[[ -z "$EXPECTED_SHA" ]] || validate_sha "$EXPECTED_SHA"

REPO="${MINIDRAMA_REPO_DIR:-/data/apps/LocalMiniDrama}"
REBUILD_ROOT="${MINIDRAMA_REBUILD_ROOT:-/data/minidrama-rebuild}"
LOG_DIR="${MINIDRAMA_REBUILD_LOG_DIR:-/var/log/minidrama-rebuild}"
LOG_FILE="${LOG_DIR}/pr-${PR_NUMBER}.log"

[[ -d "$REPO/.git" ]] || fail "Repository not found: $REPO"

log "Resolving the head commit of PR $PR_NUMBER from $REPO"
timeout 180s git -C "$REPO" fetch --no-tags origin "refs/pull/${PR_NUMBER}/head" || \
  fail "Cannot fetch refs/pull/${PR_NUMBER}/head. Check the deploy key and the PR number."
SHA="$(git -C "$REPO" rev-parse FETCH_HEAD)"
validate_sha "$SHA"
if [[ -n "$EXPECTED_SHA" && "$SHA" != "$EXPECTED_SHA" ]]; then
  fail "PR $PR_NUMBER head is $SHA, not the requested $EXPECTED_SHA."
fi

# Author gate equivalent: a fork-only commit is not the head of any branch in
# this repository. Preview deploys intentionally never run unreviewed fork code
# on the production host.
heads="$(git -C "$REPO" ls-remote origin 'refs/heads/*')" || fail 'Cannot list origin branches.'
grep -q "^${SHA}[[:space:]]" <<<"$heads" || \
  fail "Refusing to deploy $SHA: it is not the head of any branch in this repository (PR Preview applies the same same-repository rule via author_association)."

INCOMING="${INCOMING_ROOT}/${SHA}.tar.gz"
BOOTSTRAP="${REBUILD_ROOT}/${SHA}"
resolved_root="$(realpath -m "$REBUILD_ROOT")"
resolved_bootstrap="$(realpath -m "$BOOTSTRAP")"
[[ "$resolved_root" != '/' && "$resolved_bootstrap" == "$resolved_root/$SHA" ]] || \
  fail "Unsafe rebuild path: $resolved_bootstrap"

mkdir -p "$INCOMING_ROOT" "$REBUILD_ROOT" "$LOG_DIR"
log "Archiving $SHA for the deploy"
git -C "$REPO" archive --format=tar.gz --output="$INCOMING" "$SHA" || fail 'Cannot archive the PR source.'
rm -rf "$BOOTSTRAP"
mkdir -p "$BOOTSTRAP"
tar -xzf "$INCOMING" -C "$BOOTSTRAP"
[[ -f "$BOOTSTRAP/deploy/preview-deploy" ]] || fail 'Source archive is incomplete.'

if (( DETACH )); then
  : > "$LOG_FILE"
  # setsid + nohup: the build keeps running after this SSH session closes. The
  # deploy lock inside preview-deploy still serialises it against CI deploys.
  setsid nohup bash "$BOOTSTRAP/deploy/preview-deploy" "$PR_NUMBER" "$SHA" \
    >>"$LOG_FILE" 2>&1 </dev/null &
  log "Detached preview rebuild started for PR $PR_NUMBER ($SHA)."
  cat <<EOF
Preview rebuild for PR $PR_NUMBER ($SHA) is running in the background.
  follow:  tail -f $LOG_FILE
  details: preview-show $PR_NUMBER
  remove:  preview-remove $PR_NUMBER
EOF
  exit 0
fi

log "Running preview-deploy for PR $PR_NUMBER ($SHA) in the foreground"
bash "$BOOTSTRAP/deploy/preview-deploy" "$PR_NUMBER" "$SHA"
