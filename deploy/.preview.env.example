# Copy to /data/minidrama-config/.preview.env and set mode 600.
# Keep every credential independent from .prod.env.

MINIDRAMA_STORAGE_TYPE=oss
MINIDRAMA_OSS_ENDPOINT=https://oss-cn-<region>.aliyuncs.com
MINIDRAMA_OSS_BUCKET=<preview-bucket-or-shared-read-bucket>
MINIDRAMA_OSS_ACCESS_KEY_ID=<preview-access-key-id>
MINIDRAMA_OSS_ACCESS_KEY_SECRET=<preview-access-key-secret>
MINIDRAMA_OSS_PREFIX=local-mini-drama-preview
MINIDRAMA_OSS_CDN_DOMAIN=media.example.com
MINIDRAMA_OSS_AUTO_ARCHIVE_ENABLED=false

CFG_PAYMENTS__ENABLED=false
CFG_PAYMENTS__PUBLIC_BASE_URL=
CFG_PAYMENTS__MIN_AMOUNT_FEN=1
CFG_PAYMENTS__ALIPAY__ENABLED=false
CFG_PAYMENTS__ALIPAY__ENDPOINT=https://openapi-sandbox.dl.alipaydev.com/gateway.do
CFG_PAYMENTS__ALIPAY__APP_ID=
CFG_PAYMENTS__ALIPAY__APP_PRIVATE_KEY=
CFG_PAYMENTS__ALIPAY__ALIPAY_PUBLIC_KEY=
CFG_PAYMENTS__ALIPAY__SELLER_ID=
CFG_PAYMENTS__WECHAT__ENABLED=false
CFG_PAYMENTS__WECHAT__NOTIFY_URL=https://api.richbest.cn/minidrama/payments/callbacks/wechat
CFG_PAYMENTS__WECHAT__APP_ID=
CFG_PAYMENTS__WECHAT__MCH_ID=
CFG_PAYMENTS__WECHAT__MERCHANT_SERIAL_NO=
CFG_PAYMENTS__WECHAT__MERCHANT_PRIVATE_KEY=
CFG_PAYMENTS__WECHAT__API_V3_KEY=
CFG_PAYMENTS__WECHAT__WECHATPAY_PUBLIC_KEY_ID=
CFG_PAYMENTS__WECHAT__WECHATPAY_PUBLIC_KEY=
